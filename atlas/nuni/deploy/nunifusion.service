# atlas 기기용 systemd 유닛 — D-Bus 직접 활성화는 보안 레이블에 막히므로 systemd를 거쳐 띄운다
# (2026-09-19 샘플 lifecycleservice에서 확인한 방식. 플랫폼 정상 서비스들도 모두 SystemdService= 위임).
[Unit]
Description=Nuni fusion service (radar + cry + environment, com.atlas.NuniFusion1)
After=network-online.target nuni-mosquitto.service pulseaudio.service
Wants=network-online.target nuni-mosquitto.service

[Service]
Type=dbus
BusName=com.atlas.NuniFusion1
WorkingDirectory=/data/share/usr/atlas/services/com.atlas.NuniFusion1
ExecStart=/data/share/usr/atlas/services/com.atlas.NuniFusion1/nunifusion
# 설정(필요한 것만 바꾼다). 전체 목록: nunifusion --help
Environment=NUNI_MQTT_HOST=localhost
Environment=NUNI_MIC_SR=48000
Environment=NUNI_YAMNET_THREADS=2
# auto = ECO.AI(Pi 5에는 추론 플러그인이 있음) → 없으면 TFLite 직접(Pi 4)
Environment=NUNI_YAMNET_ENGINE=auto
# 기기 PulseAudio는 시스템 모드다. 기본 입력이 HDMI 쪽으로 잡힐 수 있어 USB 마이크(AB13X)를 지정한다(2026-10-19 Pi 5 확인)
Environment=NUNI_PULSE_SERVER=unix:/run/pulse/native
Environment=NUNI_PULSE_SOURCE=alsa_input.usb-Generic_AB13X_USB_Audio_20210926172016-00.mono-fallback
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
